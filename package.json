{
  "name": "graphql-codegen-apollo-typepolicies-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "testbed"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/plugin",
    "test": "npm run test --workspace=packages/plugin",
    "dev": "npm run dev --workspace=testbed",
    "codegen": "npm run codegen --workspace=testbed",
    "lint": "biome check ./",
    "lint:fix": "biome check --write ./",
    "format": "biome format --write ./"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "typescript": "^6.0.3"
  }
}
