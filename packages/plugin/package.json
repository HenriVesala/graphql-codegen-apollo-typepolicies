{
  "name": "graphql-codegen-apollo-typepolicies",
  "version": "0.1.0",
  "description": "GraphQL Codegen plugin to infer type transformations from Apollo Client type policies",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "graphql",
    "codegen",
    "apollo",
    "apollo-client",
    "type-policies",
    "typescript",
    "graphql-codegen-plugin"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@graphql-codegen/plugin-helpers": "^5.0.0 || ^6.0.0",
    "graphql": "^15.0.0 || ^16.0.0"
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/plugin-helpers": "^5.1.0",
    "@graphql-codegen/typescript": "^4.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "graphql": "^16.9.0",
    "tsup": "^8.3.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.0"
  }
}
